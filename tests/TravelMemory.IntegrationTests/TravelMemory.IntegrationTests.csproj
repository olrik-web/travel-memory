<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Passing TestContext.Current.CancellationToken to every HttpClient and EF call would
         only make an aborted run stop sooner; these tests are bounded by their own waits. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TravelMemory.Api\TravelMemory.Api.csproj" />
    <ProjectReference Include="..\..\src\TravelMemory.Worker\TravelMemory.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\sample.heic" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\oriented.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>